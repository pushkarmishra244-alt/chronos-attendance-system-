# ==============================================================================
# CHRONOS ATTENDANCE MANAGEMENT SYSTEM — ENVIRONMENT SPECIFICATIONS
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE CLIENT / SERVER METADATA
# ------------------------------------------------------------------------------
# NODE_ENV: Mode of deployment. Defaults to development. Set to 'production' in live hosting.
NODE_ENV=development

# PORT: The internal listening port for the fullstack Node process.
# Important: AI Studio reverse proxy expects the container to listen exclusively on Port 3000.
PORT=3000

# APP_URL: The public-facing endpoint where this platform is deployed.
# In development container, defaults to http://localhost:3000
APP_URL=http://localhost:3000


# ------------------------------------------------------------------------------
# 2. SECURITY & CRYPTO TOKENS
# ------------------------------------------------------------------------------
# JWT_SECRET: Private signature token for validating Access JWT envelopes (JSON Web Tokens).
# Configure a strong unique cryptographic hash in production.
JWT_SECRET=attendance-system-super-secret-key-2026

# REFRESH_SECRET: Private signature key for handling token refreshing exchanges.
REFRESH_SECRET=attendance-system-refresh-secret-2026


# ------------------------------------------------------------------------------
# 3. AI / LLM INTEGRATIONS
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Secret developer key for calling raw Gemini Generative Model endpoints.
# Required if triggering intelligent assistant analysis report features.
# AI Studio automatically mounts this securely from user account settings context.
GEMINI_API_KEY=your_gemini_api_key_here
